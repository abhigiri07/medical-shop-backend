# Copy this file to .env and fill in your real values.
# .env is gitignored, so your secrets never get committed.

# Get this from your free Postgres provider (Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string - used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=3000

# --- SMS OTP (optional) ---
# If these are left unset, OTP codes are just printed to the server console
# instead of being texted - handy for local development. Fill them in with
# your Twilio credentials to actually send SMS in production.
TWILIO_ACCOUNT_SID= AC9d93cbce8602462f003cf896a7392d7f
TWILIO_AUTH_TOKEN= SK0b6f5cf5348b7016cca885ee3b8462fa
TWILIO_FROM_NUMBER= +17372508034
