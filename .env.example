# Copy this file to .env and fill in your real values.
# .env is gitignored, so your secrets never get committed.

# Get this from your free Postgres provider (Neon, Supabase, etc.)
DATABASE_URL=postgresql://neondb_owner:npg_LZ01XJgpTsNH@ep-falling-flower-a5ubikub-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Any long random string — used to sign login sessions.
JWT_SECRET=abcdefghijklmnopqrstuvwxy6121

PORT=3000

# Used to email 6-digit codes for signup verification and password reset.
# Easiest option: a Gmail address with an "App Password" (requires 2-Step
# Verification on the Google account): https://myaccount.google.com/apppasswords
# Without these set, codes are just printed to the server console instead
# of being emailed — fine for local testing, not for production.
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16charapppassword
# Optional: only needed if NOT using Gmail. Set your provider's SMTP host/port instead.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_FROM=noreply@yourdomain.com
